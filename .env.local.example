# Voxonix — Supabase environment variables
#
# Copy this file to .env.local and fill in your project credentials.
# You can find these in your Supabase project at:
#   https://app.supabase.com → Project Settings → API
#
# NEVER commit .env.local to version control.
# NEVER use the service-role key here — only the publishable key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
